# 複製成 .env，把 change-me 換成你自己的密碼（兩個地方要一樣）。.env 不會進 git。
# docker compose 會讀這裡的 POSTGRES_*；程式（API、migrate、seed、測試）讀 DATABASE_URL。

POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokemon

# 從你的電腦連 Docker 裡的資料庫：localhost:5433
DATABASE_URL=postgresql://pokemon:change-me@localhost:5433/pokemon
